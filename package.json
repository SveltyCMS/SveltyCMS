{
  "name": "create-sveltycms",
  "version": "0.13.0",
  "description": "Scaffold a new SveltyCMS headless CMS project — SvelteKit 3 + Svelte 5 + 4 databases",
  "keywords": [
    "AI-Powered CMS",
    "DXP Digital",
    "Developer Experience Platform",
    "best-cms",
    "cms",
    "component-library",
    "content-management-system",
    "enterprise-cms",
    "fast-cms",
    "fastest-cms",
    "graphql",
    "headless",
    "headless-cms",
    "i18n",
    "inlang",
    "internationalization",
    "mariadb",
    "mcp-server",
    "mongodb",
    "mongodb-atlas",
    "oauth",
    "paraglide-js",
    "postgres",
    "rich-text-editor",
    "svelte",
    "svelte-cms",
    "sveltekit",
    "sveltekit_cms",
    "sveltycms",
    "tailwind",
    "tailwindcss",
    "tiptap",
    "wcag3",
    "wysiwyg"
  ],
  "homepage": "https://SveltyCMS.com",
  "bugs": {
    "url": "https://github.com/SveltyCMS/SveltyCMS/issues"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/SveltyCMS/SveltyCMS"
  },
  "bin": {
    "create-sveltycms": "./scripts/create-app.js"
  },
  "files": [
    "scripts/create-app.js",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte",
    "src/utils/v8-shim.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "devv": "LAUNCH_EDITOR='code' vite dev --open",
    "start": "bun index.cjs",
    "start:bun": "bun build/index.js",
    "start:node": "node index.cjs",
    "start:cluster": "bun scripts/cluster-serve.ts",
    "update": "bun update && bun run audit:sbom",
    "build": "vite build",
    "build:fast": "BUILD_SOURCEMAP=false vite build",
    "build:api": "SVELTY_API_ONLY=1 vite build",
    "build:node": "ADAPTER=node vite build",
    "build:bun": "ADAPTER=bun vite build",
    "build:verbose": "vite build --debug",
    "build:analyze": "vite build ; bun x vite-bundle-visualizer",
    "build:stats": "vite build ; bun run scripts/bundle-stats.ts",
    "build:e2e": "COMPILE_ALL_ADAPTERS=true vite build",
    "gate:fast": "bun x lint-staged",
    "gate": "bash .githooks/pre-push",
    "git": "bun run scripts/git-safe.ts",
    "precommit": "bash .githooks/pre-commit",
    "prepush": "bash .githooks/pre-push",
    "format": "oxfmt",
    "check": "node scripts/security/check-node-runtime.ts && bun run format --check && oxlint --deny-warnings --ignore-pattern 'src/types/**' && bun run scripts/check/run-fast-checks.ts && bun run typecheck",
    "check:node-runtime": "node scripts/security/check-node-runtime.ts",
    "check:copy": "bun run scripts/check/check-hardcoded-copy.ts",
    "check:routes": "bun run scripts/check/check-route-behaviour.ts --check --min=99",
    "check:route-manifest": "bun run scripts/check/check-route-manifest.ts",
    "check:test-inventory": "bun run scripts/check/check-test-inventory.ts",
    "check:seams": "bun run scripts/check/check-seam-assertions.ts",
    "check:linkmap": "bun run scripts/check/analyze-linkmap.ts",
    "check:linkmap:changed": "bun run scripts/check/analyze-linkmap.ts --changed --check",
    "check:leanness": "bun run scripts/check/leanness-benchmark.ts",
    "check:ast": "bun run scripts/check/run-ast-gates.ts",
    "typecheck": "svelte-kit sync && bun run scripts/check/run-typecheck.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint --deny-warnings --ignore-pattern 'src/types/**'",
    "lint:ci": "oxlint --deny-warnings --quiet --format=github --ignore-pattern 'src/types/**'",
    "lint:widgets": "bun run scripts/lint/lint-widgets.ts",
    "lint:e2e-hydration": "bun run scripts/lint/lint-e2e-hydration.ts --check",
    "lint:trivial-assertions": "bun run scripts/lint/lint-trivially-true-assertions.ts --check",
    "lint:global-timers": "bun run scripts/lint/lint-global-timers.ts",
    "lint:live-paths": "bun run scripts/lint/lint-live-paths.ts",
    "lint:tenant-scope": "bun run scripts/lint/lint-tenant-scope.ts",
    "lint:transient-classification": "bun run scripts/lint/lint-transient-classification.ts",
    "lint:date-helpers": "bun run scripts/lint/lint-date-helpers.ts",
    "lint:silent-catch": "bun run scripts/lint/lint-silent-catch.ts",
    "lint:remote-transport": "bun run scripts/lint/scan-remote-transport.ts",
    "lint:rule-budgets": "bun run scripts/lint/lint-rule-budgets.ts",
    "lint:e2e-actionability": "bun run scripts/lint/lint-e2e-actionability.ts",
    "lint:marketplace": "bun run scripts/sync-marketplace-catalog.ts --check",
    "marketplace:conformance": "bun run scripts/marketplace/conformance.ts",
    "extension:extract": "bun run scripts/extract-extension.ts",
    "lint:design": "bun run scripts/lint/lint-design.ts",
    "lint:testids": "bun run scripts/lint/lint-duplicate-testids.ts",
    "lint:leaks": "bun run scripts/lint/scan-anonymous-leaks.ts",
    "lint:tenant": "bun run scripts/lint/lint-tenant-api.ts",
    "lint:docs": "bun tests/lint/docs.ts",
    "lint:benchmark-mdx": "bun run scripts/lint/lint-benchmark-mdx.ts",
    "test": "bun run test:unit",
    "test:unit": "bun run scripts/check/ensure-paraglide.ts && svelte-kit sync && bun run scripts/test/run-unit-suite.ts",
    "test:unit:coverage": "bun run scripts/check/ensure-paraglide.ts && svelte-kit sync && bun run scripts/test/run-unit-suite.ts --coverage",
    "test:coverage": "bun run test:unit:coverage && bun run test:coverage:budget",
    "test:coverage:budget": "bun run scripts/test/check-coverage-budget.ts",
    "test:coverage:write-path": "COVERAGE_WRITE_PATH=1 bun run test:unit:coverage",
    "test:isolation": "bun run scripts/test/check-integration-isolation.ts --check",
    "test:coverage:dom": "node ./node_modules/vitest/vitest.mjs run --config vitest.dom.config.ts --coverage",
    "coverage:merge": "bun run scripts/merge-coverage.ts",
    "test:coverage:all": "COVERAGE_ALL=1 VITEST_MAX_WORKERS=4 bun run test:unit:coverage && node ./node_modules/vitest/vitest.mjs run --config vitest.dom.config.ts --coverage && bun run coverage:merge",
    "test:unit:core": "node ./node_modules/vitest/vitest.mjs run tests/unit/auth tests/unit/hooks tests/unit/security tests/unit/databases",
    "test:unit:components": "bun run scripts/test/run-unit-suite.ts --config=vitest.dom.config.ts --layer=components",
    "test:unit:fast": "node ./node_modules/vitest/vitest.mjs run --bail 1",
    "test:unit:watch": "node ./node_modules/vitest/vitest.mjs watch",
    "test:unit:changed": "bun run scripts/test/test-unit-changed.ts",
    "test:unit:area": "node ./node_modules/vitest/vitest.mjs run",
    "test:mutation": "bun run scripts/test/mutate-core.ts",
    "test:mutation:security": "bun run scripts/test/mutate-core.ts --security-only",
    "test:contract": "bun run scripts/test/test-contract.ts",
    "test:doctor": "bun run scripts/test/test-doctor.ts",
    "test:smart": "bun run scripts/test/test-smart.ts",
    "test:security": "bun run scripts/check/ensure-paraglide.ts && svelte-kit sync && node ./node_modules/vitest/vitest.mjs run tests/unit/hooks/defense-in-depth.test.ts tests/unit/hooks/authentication.test.ts tests/unit/hooks/authorization.test.ts tests/unit/hooks/file-server-tenant.test.ts tests/unit/hooks/collection-read-lane.test.ts tests/unit/hooks/collection-write-lane.test.ts tests/unit/security/user-attribute-policy.test.ts tests/unit/security/egress-guard.test.ts tests/unit/security/prototype-pollution.test.ts tests/unit/media/processing/svg-sanitization.test.ts tests/unit/media/processing/media-svg-ssrf-regression.test.ts tests/unit/scripts/scan-security-risk.test.ts tests/unit/api/graphql-security.test.ts tests/unit/api/user.test.ts tests/unit/security/handle-waf-guard.test.ts tests/unit/security/audit-ledger-integrity.test.ts tests/unit/services/field-write-guard.test.ts tests/unit/auth/sessions/session-user.test.ts tests/unit/auth/webauthn/webauthn-ceremony.test.ts tests/unit/auth/sso/sso-session-metadata.test.ts tests/unit/security/red-team-corpus.test.ts",
    "test:integration": "bun run scripts/runs/run-integration.ts",
    "test:integration:sqlite": "bun run scripts/runs/run-integration.ts --no-build",
    "test:integration:smoke": "bun run scripts/runs/start-integration-server.ts && node ./node_modules/vitest/vitest.mjs run --testTimeout=120000 tests/integration/databases/contract.test.ts tests/integration/api/widgets.test.ts tests/integration/api/session-page-load.test.ts",
    "test:integration:server": "bun run scripts/runs/start-integration-server.ts",
    "test:e2e": "bun run scripts/runs/run-e2e.ts",
    "test:e2e:dev": "bun run scripts/runs/run-e2e.ts --dev",
    "test:e2e:quick": "bun run scripts/runs/run-e2e.ts --no-build",
    "test:e2e:smoke": "bun run scripts/runs/run-e2e.ts --no-build tests/e2e/smoke.spec.ts",
    "test:e2e:editorial": "bun run scripts/runs/run-e2e.ts --no-build tests/e2e/smoke.spec.ts tests/e2e/routes/collection-builder/kitchen-sink.spec.ts tests/e2e/routes/admin/editor-boundary.spec.ts",
    "benchmark:browser": "bun run scripts/runs/run-e2e.ts --no-build tests/e2e/browser-vitality.spec.ts",
    "benchmark:mcp-security": "bun test tests/benchmarks/mcp-security-performance.test.ts",
    "test:tenant": "bun run scripts/check/ensure-paraglide.ts && bun run lint:tenant && node ./node_modules/vitest/vitest.mjs run tests/unit/security/tenant-isolation-matrix.test.ts tests/unit/security/safe-query-manual.test.ts tests/unit/security/system-tenant-scope.test.ts tests/unit/multi-tenancy/crud-tenant-guard.test.ts",
    "test:tenant:integration": "bun run scripts/runs/run-integration.ts --no-build tests/integration/databases/tenant-isolation.test.ts",
    "test:matrix": "bun run scripts/runs/run-local-db-matrix.ts",
    "test:matrix:local": "bun run scripts/runs/run-local-db-matrix.ts",
    "test:parity": "bun run scripts/runs/run-local-db-matrix.ts",
    "test:parity:docker": "bun run scripts/runs/run-local-db-matrix.ts --docker --build",
    "flake:budget": "bun run scripts/check/check-flake-budget.ts",
    "flake:trend": "bun run scripts/check/check-flake-trend.ts",
    "flake:probe": "bun run scripts/runs/e2e-flake-nightly.ts",
    "test:all": "bun run test:unit && bun run scripts/runs/run-integration.ts",
    "security": "bun run scripts/security/security-audit.ts",
    "security:auth": "bun run scripts/security/security-audit.ts --auth",
    "risk:audit": "bun run scripts/security/risk-audit.ts",
    "security:assurance": "bun run scripts/security/security-assurance.ts",
    "security:assurance:doc": "bun run scripts/security/check-advisories.ts --write-doc",
    "security:threat-model:update": "bun run scripts/security/check-threat-model-drift.ts --update",
    "slop": "bun run scripts/security/slop-scanner.ts",
    "audit:backdoor": "bun run scripts/security/verify-prod-build-backdoor.ts",
    "audit:sbom": "bun run scripts/security/generate-sbom.ts",
    "verify:benchmark-local": "bun run scripts/verify-benchmark-local.ts",
    "benchmark": "bun run verify:benchmark-local && bun scripts/benchmark-matrix/index.ts",
    "benchmark:clean": "bun run scripts/benchmark-matrix/prune-benchmark-results.ts",
    "benchmark:ci": "bun scripts/benchmark-matrix/index.ts --ci",
    "benchmark:core": "bun run verify:benchmark-local && bun run scripts/runs/run-core-benchmarks.ts",
    "benchmark:gate": "bun run scripts/benchmark-matrix/ci-regression-gate.ts",
    "preview": "PORT=4173 node build/index.js",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "version:bump": "bun run scripts/version.ts",
    "version:verify": "bun run scripts/version.ts --verify",
    "repair:drizzle": "node -e \"try{require('fs').accessSync('node_modules/drizzle-orm/sql/index.js');process.exit(0)}catch(e){process.exit(1)}\" || (npm remove drizzle-orm 2>/dev/null; npm install drizzle-orm)",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --output-structure locale-modules --emit-ts-declarations --is-server 'import.meta.env.SSR'",
    "translate": "npx @inlang/cli machine translate --project ./project.inlang",
    "upgrade": "bun run scripts/upgrade.ts",
    "config": "bun run scripts/config-cli.ts",
    "config:export": "bun run scripts/config-cli.ts export",
    "config:import": "bun run scripts/config-cli.ts import",
    "config:status": "bun run scripts/config-cli.ts status",
    "config:diff": "bun run scripts/config-cli.ts diff",
    "config:plan": "bun run scripts/config-cli.ts plan",
    "media:backfill-previews": "bun run scripts/media/backfill-previews.ts",
    "migrate": "bun run src/plugins/smart-importer/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1167.0",
    "@better-svelte-email/components": "^2.3.0",
    "@better-svelte-email/preview": "^2.3.0",
    "@better-svelte-email/server": "^2.3.0",
    "@envelop/graphql-jit": "^12.0.1",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@hyzyla/pdfium": "^3.0.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@mcp-b/webmcp-polyfill": "^6.2.0",
    "@node-saml/node-saml": "^5.2.0",
    "@smithy/node-http-handler": "^4.14.2",
    "@sveltejs/kit": "^3.2.0",
    "@tailwindcss/typography": "^0.5.20",
    "@thisux/sveltednd": "0.8.0",
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-character-count": "^3.33.1",
    "@tiptap/extension-color": "^3.33.1",
    "@tiptap/extension-font-family": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-link": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-table-cell": "^3.33.1",
    "@tiptap/extension-table-header": "^3.33.1",
    "@tiptap/extension-table-row": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/extension-underline": "^3.33.1",
    "@tiptap/extension-youtube": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "argon2": "^0.45.2",
    "cloudinary": "^2.11.0",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.4",
    "graphql": "17.1.0",
    "graphql-yoga": "^6.1.0",
    "hls.js": "^1.7.4",
    "iconify-icon": "^3.0.5",
    "maplibre-gl": "^6.18.0",
    "nodemailer": "^10.5.0",
    "ollama": "^0.6.4",
    "redis": "^6.3.1",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "stripe": "^23.1.0",
    "svedit": "^0.15.2",
    "svelte-canvas": "^2.1.0",
    "typescript": "6.0.3",
    "uqr": "^0.1.3",
    "valibot": "^1.5.0",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "^1.4.4",
    "@types/google.maps": "^3.66.10",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/ws": "^8.18.2",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/ui": "^5.1.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "mysql2": "^3.24.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "postgres": "^4.0.0",
    "svelte": "^5.57.3",
    "svelte-adapter-bun": "^1.0.2",
    "svelte-awesome-color-picker": "^4.1.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "ts-morph": "^28.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "mongoose": "^9.12.1",
    "mysql2": "^3.24.6",
    "postgres": "^4.1.1"
  },
  "overrides": {
    "@graphql-tools/utils": "^13.1.3",
    "@xmldom/xmldom": ">=0.8.15",
    "brace-expansion": ">=5.0.9",
    "deepmerge-ts": ">=8.0.2",
    "fast-uri": ">=4.1.3",
    "graphql-jit": ">=0.9.3",
    "minimatch": "^11.0.3",
    "nanoid": "3.3.18",
    "postcss": ">=8.5.23",
    "postcss-selector-parser": "^7.1.6",
    "shell-quote": ">=1.8.5"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
