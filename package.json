{
  "name": "create-sveltycms",
  "version": "0.0.7",
  "description": "Scaffold a new SveltyCMS headless CMS project — SvelteKit 2 + Svelte 5 + 4 databases",
  "keywords": [
    "AI-Powered CMS",
    "DXP Digital",
    "Developer Experience Platform",
    "best-cms",
    "cms",
    "component-library",
    "content-management-system",
    "enterprise-cms",
    "fast-cms",
    "fastest-cms",
    "graphql",
    "headless",
    "headless-cms",
    "i18n",
    "inlang",
    "internationalization",
    "mariadb",
    "mcp-server",
    "mongodb",
    "mongodb-atlas",
    "oauth",
    "paraglide-js",
    "postgres",
    "rich-text-editor",
    "svelte",
    "svelte-cms",
    "sveltekit",
    "sveltekit_cms",
    "sveltycms",
    "tailwind",
    "tailwindcss",
    "tiptap",
    "wcag3",
    "wysiwyg"
  ],
  "homepage": "https://SveltyCMS.com",
  "bugs": {
    "url": "https://github.com/SveltyCMS/SveltyCMS/issues"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/SveltyCMS/SveltyCMS"
  },
  "bin": {
    "create-sveltycms": "./scripts/create-app.ts"
  },
  "files": [
    "scripts/create-app.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "-- DEVELOP -------------------------------------------": "",
    "dev": "vite dev",
    "devv": "LAUNCH_EDITOR='code' vite dev --open",
    "-- DEPENDENCIES --------------------------------------": "",
    "update": "bun update && bun run audit:sbom",
    "-- BUILD ---------------------------------------------": "",
    "build": "vite build && esbuild src/services/collaboration/yjs-sync-server.ts --bundle --platform=node --format=esm --minify --tree-shaking=true --target=node24 --outfile=build/yjs-sync-server.js --external:ws --external:yjs --external:y-protocols --external:lib0 --alias:@utils=./src/utils && node -e \"require('fs').cpSync('src/content/module-worker.server.ts','build/server/chunks/module-worker.server.ts')\"",
    "build:verbose": "vite build && esbuild src/services/collaboration/yjs-sync-server.ts --bundle --platform=node --format=esm --minify --tree-shaking=true --target=node24 --outfile=build/yjs-sync-server.js --external:ws --external:yjs --external:y-protocols --external:lib0 --alias:@utils=./src/utils",
    "build:high-memory": "NODE_OPTIONS=\"--max-old-space-size=16384\" vite build && esbuild src/services/collaboration/yjs-sync-server.ts --bundle --platform=node --format=esm --minify --tree-shaking=true --target=node24 --outfile=build/yjs-sync-server.js --external:ws --external:yjs --external:y-protocols --external:lib0 --alias:@utils=./src/utils",
    "build:low-memory": "NODE_OPTIONS=\"--max-old-space-size=4096\" vite build && esbuild src/services/collaboration/yjs-sync-server.ts --bundle --platform=node --format=esm --minify --tree-shaking=true --target=node24 --outfile=build/yjs-sync-server.js --external:ws --external:yjs --external:y-protocols --external:lib0 --alias:@utils=./src/utils",
    "build:analyze": "NODE_OPTIONS=\"--max-old-space-size=8192\" npx vite-bundle-visualizer && $npm_execpath run build:verbose",
    "build:report": "$npm_execpath run build:verbose && du -h .svelte-kit/output/client/_app/immutable/chunks/*.js | sort -rh | head -20",
    "build:stats": "bun run build:verbose && bun run scripts/bundle-stats.ts",
    "-- QUALITY GATES -------------------------------------": "",
    "gate:fast": "bun x lint-staged",
    "gate": "bash .githooks/pre-push",
    "git": "bun run scripts/git-safe.ts",
    "precommit": "bash .githooks/pre-commit",
    "prepush": "bash .githooks/pre-push",
    "-- CHECK & TEST ---------------------------------------": "",
    "format": "oxfmt",
    "check": "bun run format --check && oxlint --deny-warnings --ignore-pattern 'src/types/**' && bun run lint:widgets && bun run scripts/check-lockfile-sync.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "bun run test:unit",
    "test:unit": "svelte-kit sync && vitest run",
    "test:smart": "bun run scripts/test-smart.ts",
    "test:doctor": "bun run scripts/test-doctor.ts",
    "test:security": "svelte-kit sync && vitest run tests/unit/hooks/defense-in-depth.test.ts tests/unit/hooks/authentication.test.ts tests/unit/hooks/authorization.test.ts tests/unit/hooks/file-server-tenant.test.ts tests/unit/security/user-attribute-policy.test.ts tests/unit/security/egress-guard.test.ts tests/unit/media/processing/svg-sanitization.test.ts tests/unit/media/processing/media-svg-ssrf-regression.test.ts tests/unit/scripts/scan-security-risk.test.ts tests/unit/api/graphql-security.test.ts tests/unit/api/user.test.ts tests/unit/security/wasm-waf-guard.test.ts tests/unit/security/audit-ledger-integrity.test.ts",
    "test:integration": "bun run scripts/run-integration.ts",
    "test:integration:sqlite": "bun run scripts/run-integration.ts --no-build",
    "test:integration:smoke": "bun run scripts/start-integration-server.ts && bun test --timeout 120000 tests/integration/databases/contract.test.ts tests/integration/api/widgets.test.ts tests/integration/api/session-page-load.test.ts",
    "test:integration:server": "bun run scripts/start-integration-server.ts",
    "test:e2e": "bun run scripts/run-e2e.ts",
    "test:e2e:dev": "bun run scripts/run-e2e.ts --dev",
    "test:e2e:quick": "bun run scripts/run-e2e.ts --no-build",
    "build:e2e": "COMPILE_ALL_ADAPTERS=true vite build",
    "test:unit:coverage": "svelte-kit sync && vitest run --coverage",
    "test:matrix": "bun run scripts/run-all-db-matrix.ts",
    "test:all": "bun run test:unit && bun run scripts/run-integration.ts",
    "-- ANALYSIS -------------------------------------------": "",
    "security": "bun run scripts/security-audit.ts",
    "security:auth": "bun run scripts/security-audit.ts --auth",
    "risk:audit": "bun run scripts/risk-audit.ts",
    "slop": "bun run scripts/slop-scanner.ts",
    "audit:backdoor": "bun run scripts/verify-prod-build-backdoor.ts",
    "verify:benchmark-local": "bun run scripts/verify-benchmark-local.ts",
    "audit:sbom": "bun run scripts/generate-sbom.ts",
    "-- LINT & FORMAT --------------------------------------": "",
    "lint": "oxlint --deny-warnings --ignore-pattern 'src/types/**'",
    "lint:ci": "oxlint --deny-warnings --quiet --format=github --ignore-pattern 'src/types/**'",
    "lint:widgets": "bun run scripts/check-widget-naming.mjs && bun run scripts/check-dashboard-widget-packages.mjs",
    "lint:tenant": "bun run scripts/lint-tenant-api.ts",
    "test:tenant": "bun run lint:tenant && bun test tests/unit/security/tenant-isolation-matrix.test.ts tests/unit/security/safe-query-manual.test.ts tests/unit/security/system-tenant-scope.test.ts tests/unit/multi-tenancy/crud-tenant-guard.test.ts",
    "test:tenant:integration": "bun run scripts/run-integration.ts --no-build tests/integration/databases/tenant-isolation.test.ts",
    "lint:docs": "bun tests/lint-docs.ts",
    "-- BENCHMARKS ----------------------------------------": "",
    "benchmark": "bun run verify:benchmark-local && bun scripts/benchmark-matrix/index.ts",
    "benchmark:ci": "bun scripts/benchmark-matrix/index.ts --ci",
    "benchmark:core": "bun run verify:benchmark-local && bun run scripts/run-core-benchmarks.ts",
    "-- OTHER ----------------------------------------------": "",
    "preview": "PORT=4173 node build/index.js",
    "prepare": "git config core.hooksPath .githooks",
    "repair:drizzle": "node -e \"try{require('fs').accessSync('node_modules/drizzle-orm/sql/index.js');process.exit(0)}catch(e){process.exit(1)}\" || (npm remove drizzle-orm 2>/dev/null; npm install drizzle-orm)",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "translate": "npx @inlang/cli machine translate --project ./project.inlang",
    "upgrade": "npx tsx scripts/upgrade.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@better-svelte-email/components": "^2.1.1",
    "@better-svelte-email/preview": "^2.1.1",
    "@better-svelte-email/server": "^2.1.1",
    "@envelop/graphql-jit": "^11.1.1",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@inlang/paraglide-js": "^2.23.2",
    "@mcp-b/webmcp-polyfill": "^4.0.0",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@smithy/node-http-handler": "^4.9.13",
    "@sveltejs/kit": "^2.70.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@thisux/sveltednd": "0.7.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-collaboration": "^3.29.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-font-family": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/extension-youtube": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/y-tiptap": "^3.0.8",
    "argon2": "0.45.1",
    "cloudinary": "^2.10.0",
    "dompurify": "^3.4.13",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "google-auth-library": "^11.0.0",
    "graphql": "16.14.2",
    "graphql-jit": "^0.8.8",
    "graphql-yoga": "^5.21.2",
    "hash-wasm": "^4.12.0",
    "iconify-icon": "^3.0.2",
    "json-render-svelte": "^0.6.1",
    "lru-cache": "^11.5.2",
    "maplibre-gl": "^6.3.0",
    "mime-types": "^3.0.2",
    "node-os-utils": "^2.0.4",
    "nodemailer": "^9.0.5",
    "ollama": "^0.6.3",
    "rate-limiter-flexible": "^11.2.0",
    "redis": "^6.2.0",
    "rolldown": "^1.2.3",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "stripe": "^22.4.0",
    "svedit": "^0.13.0",
    "svelte-canvas": "^2.1.0",
    "sveltekit-rate-limiter": "^0.7.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "valibot": "^1.4.2",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@iconify/svelte": "^5.2.2",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@sveltejs/vite-plugin-svelte-inspector": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.3.14",
    "@types/google.maps": "^3.65.5",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.2.0",
    "@types/node-os-utils": "^1.3.4",
    "@types/nodemailer": "^8.0.1",
    "@types/serialize-javascript": "^5.0.4",
    "@types/ws": "^8.18.1",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "bun-types": "1.3.14",
    "concurrently": "^10.0.4",
    "fast-check": "^4.9.0",
    "glob": "^13.0.6",
    "globals": "^17.9.0",
    "jsdom": "30.0.1",
    "lint-staged": "^17.3.0",
    "mysql2": "^3.16.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.62.1",
    "postgres": "^3.4.8",
    "svelte": "^5.56.8",
    "svelte-awesome-color-picker": "^4.1.3",
    "svelte-check": "^4.7.5",
    "svelte-dnd-action": "^0.9.78",
    "ts-morph": "^28.0.0",
    "tslib": "^2.8.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "9.1.0"
  },
  "optionalDependencies": {
    "mongoose": "^9.9.2",
    "mysql2": "^3.23.3",
    "postgres": "^3.4.9"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "cookie": "0.7.0",
    "fast-uri": ">=3.1.5",
    "postcss": ">=8.5.23",
    "shell-quote": ">=1.8.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
