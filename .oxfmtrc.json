{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "overrides": [
    {
      "files": ["**/*.svelte"],
      "options": {
        "svelte": {},
        "useTabs": true,
        "singleQuote": true,
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "node_modules/**",
    "build/**",
    "dist/**",
    ".svelte-kit/**",
    "src/paraglide/**",
    ".compiledCollections/**",
    "coverage/**",
    "sbom.json"
  ]
}
