#!/usr/bin/env sh
# =============================================================================
# SveltyCMS Pre-Commit (Stage 1) — Safety → Lint-Staged → Check → Risk → Unit
#
# Fast white-box gate (~35-45 s). No production build or server spin-up runs at
# commit time — Stage 2 (.githooks/pre-push) owns the 4-adapter build, SQLite
# integration, DB parity, E2E browser contracts, and seam mutations.
# POLICY: enforced. A commit only lands when quality, risk, and unit gates pass.
# --no-verify is blocked; use 'bun run scripts/git-safe.ts commit'.
# =============================================================================
set -u
[ "${CI:-false}" = "true" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib.sh"

header "Pre-Commit"
require_bun

# Local gates are ENFORCED (owner decision 2026-10-24). The earlier opt-in
# policy was the reason a commit could be green locally while the CI Unit job
# was red: the hook exited before running anything. The hook now runs on every
# commit; CI remains the authority for the multi-DB/E2E matrix.

TOTAL=7; OK=0

# Step 1 — Database & live-config safety (<50ms)
if run "🛡️  Database safety" pm_run scripts/check/check-test-db-safety.ts; then
  OK=$((OK + 1))
fi

# Step 2 — Lint-staged (auto-formats staged files first so `check` never fails on formatting)
if run "⚡  Lint-staged" pm_run gate:fast; then
  OK=$((OK + 1))
fi

# Step 3 — Quality gate (format --check + oxlint + custom guards + svelte-kit sync + typecheck)
if run "🔍  Quality Gate (check)" pm_run check; then
  OK=$((OK + 1))
else
  # Fallback auto-format for already-staged files only (never sweep unstaged work)
  STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|js|svelte|json|md|mdx)$' || true)
  if [ -n "$STAGED_FILES" ]; then
    pm_run format > /dev/null 2>&1
    printf '%s\n' "$STAGED_FILES" | xargs git add 2>/dev/null || true
  fi

  if run "🔍  Re-checking after format" pm_run check; then
    warn "Staged files auto-formatted and updated."
    OK=$((OK + 1))
  else
    warn "Lint or type errors remain after formatting."
  fi
fi

# Step 4 — Full risk audit (DB injection classes, secrets, XSS, dependency CVEs, OSV)
if has_staged_changes '\.(md|mdx)$' && ! has_staged_changes '\.(ts|js|svelte)$' && ! has_staged_changes 'bun\.lock|package\.json'; then
  warn "Only docs changed — skipping risk audit"
  TOTAL=$((TOTAL - 1))
elif run "🛡️  Risk audit (DB/SvelteKit/deps/OSV)" pm_run risk:audit; then
  OK=$((OK + 1))
fi

# Step 5 — Unit tests (skip if only docs changed; invokes Vitest directly since Step 3 already ran svelte-kit sync)
if has_staged_changes '\.(md|mdx)$' && ! has_staged_changes '\.(ts|js|svelte)$'; then
  warn "Only docs changed — skipping unit tests"
  TOTAL=$((TOTAL - 1))
elif run "🧪  Unit tests" node ./node_modules/vitest/vitest.mjs run; then
  OK=$((OK + 1))
fi

# Step 6 — Component interaction tests (real DOM mount; runs when UI/Svelte/component/store files are staged)
if ! has_staged_changes '\.svelte$|^(src/(components|routes|widgets|stores)/|tests/unit/components/|vitest\.dom\.config\.ts)'; then
  info "No UI/component changes staged — skipping DOM component tests"
  TOTAL=$((TOTAL - 1))
elif run "🧩  Component interactions" pm_run test:unit:components; then
  OK=$((OK + 1))
fi

# Step 7 — SBOM sync (keeps sbom.json in lockstep with bun.lock)
if has_staged_changes 'bun\.lock|package\.json'; then
  if run "📦  SBOM sync" pm_run audit:sbom; then
    git add sbom.json 2>/dev/null || true
    info "sbom.json regenerated from updated lockfile and staged."
    OK=$((OK + 1))
  fi
else
  warn "No dependency changes — SBOM already up to date"
  TOTAL=$((TOTAL - 1))
fi

summary "$OK" "$TOTAL"
