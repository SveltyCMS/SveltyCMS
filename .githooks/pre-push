#!/usr/bin/env sh
# =============================================================================
# SveltyCMS Pre-Push — Build → CI-parity Unit → SQLite Integration → Browser
#
# Pre-commit already ran: format, lint, unit, component interactions.
# This hook re-runs the complete CI Unit job (coverage + components + mutation,
# because unhandled errors only surface under the CI reporter), builds the
# project, runs SQLite integration, DB parity when adapter code changed, and the
# browser contract gate (including any changed E2E spec).
#
# POLICY: enforced — there is no opt-out environment variable.
# Flags:
#   --only-failures      Skip build, re-run only previously failed suites via test:smart
#   SKIP_DB_PARITY=true  Skip the adapter parity step
#   SKIP_E2E_SMOKE=true  Skip the Chromium smoke gate
#
# Release: a push to `main` that passes the gate IS a release. The hook derives
# the next SemVer from Conventional Commits (`scripts/version.ts auto`, falling
# back to the next free patch when that version is already tagged), commits
# `chore(release): bump version to vX.Y.Z`, pushes that commit to main itself,
# then aborts the now-stale original push (git resolved this push's SHAs before
# the hook ran). CI then runs; on green, auto-release.yaml tags the version the
# manifest already carries. Nothing a human types but `git push`.
# =============================================================================
set -u
[ "${CI:-false}" = "true" ] && exit 0
# The release step below performs its own push; skip this hook for that push so
# it cannot recurse.
[ "${NESTED_RELEASE_PUSH:-}" = "1" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib.sh"

require_bun
header "Pre-Push"

# Local gates are ENFORCED (owner decision 2026-10-24). The previous opt-in
# policy let a green hook coexist with a red CI run; every step below now runs
# unless its skip flag is explicitly set.

ONLY_FAILURES=false
PUSH_REFS=""

# Parse optional arguments
for arg in "$@"; do
  case "$arg" in
    --only-failures)
      ONLY_FAILURES=true
      ;;
  esac
done

# git hands the refs it is about to push on stdin — one
# `<local ref> <local sha> <remote ref> <remote sha>` line per ref. Capture the
# branch refs so the release step can (a) know whether main is being pushed and
# (b) push the same ref itself. `[ ! -t 0 ]` keeps manual runs from blocking.
PUSHED_BRANCHES=""
if [ ! -t 0 ]; then
  while read -r local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/heads/*)
        PUSH_REFS="$PUSH_REFS ${local_ref}:${remote_ref}"
        PUSHED_BRANCHES="$PUSHED_BRANCHES ${remote_ref#refs/heads/}"
        ;;
    esac
  done
fi

# Changed paths vs the upstream merge-base — used for the E2E target mapping.
push_changed_files() {
  local base
  base="$(git merge-base HEAD @{upstream} 2>/dev/null || echo 'HEAD~1')"
  git diff --name-only "$base" -- 2>/dev/null || true
}

# ── Smart skip: if only docs changed, skip build + integration ───────────
if ! has_push_changes '\.(md|mdx)$' || has_push_changes '\.(ts|js|svelte|css|json)$'; then
  HAS_CODE_CHANGES=true
else
  HAS_CODE_CHANGES=false
fi

if [ "$ONLY_FAILURES" = true ]; then
  info "Running only previously failed suites (--only-failures)"
  echo ""
  TOTAL=1; OK=0
  if run "🔁  Smart retry (failed suites)" bun run test:smart --only-failures; then
    OK=$((OK + 1))
  fi
  summary "$OK" "$TOTAL"
  exit $?
fi

# ── CI/workflow-only changes still run the local gate ─────────────────────
# The old shortcut skipped everything for `.github/**` edits, which is how a
# workflow change could be pushed without even a YAML parse. The normal steps
# now run; the dedicated YAML step below validates every workflow file.
if [ "$HAS_CODE_CHANGES" = false ]; then
  warn "Only docs changed — skipping build and integration tests"
  echo ""
  summary 1 1
  exit 0
fi

info "Pre-commit already verified: format, lint, unit tests, component interactions."
info "Pre-push: build + quality + security + backdoor probe + release readiness + SQLite integration + DB parity + E2E contract gate"
echo ""

TOTAL=17; OK=0

# Step 1 — Production build (mirrors CI build job)
if run "🏗️  Build (4 adapters)" env COMPILE_ALL_ADAPTERS=true "$PM_BIN" run build; then
  OK=$((OK + 1))
fi

# Step 1b — Post-build verifiers (mirrors CI build job steps)
if run "🚪  Prod build backdoor (bench mode)" pm_run scripts/security/verify-prod-build-backdoor.ts --mode=bench; then
  OK=$((OK + 1))
fi
if run "📦  Bundle size gate" pm_run scripts/check/check-bundle-size.ts; then
  OK=$((OK + 1))
fi

# Step 2 — Quality gate (TypeScript + Svelte check — mirrors CI whitebox)
if run "✅  Quality Gate (check)" pm_run check; then
  OK=$((OK + 1))
fi

# Step 2c — CI-parity unit job (coverage + components + mutation)
#
# CI runs these under a different reporter, and a suite can be 100 % green and
# still exit 1 on unhandled errors (jsdom teardown, icon timers, leaked
# promises). That is exactly how the Unit job stayed red while every local
# assertion passed. Run the same three commands before the push.
if run "🧪  Unit coverage (CI parity)" pm_run test:unit:coverage; then
  OK=$((OK + 1))
fi
if run "🧩  Component interactions (CI parity)" pm_run test:unit:components; then
  OK=$((OK + 1))
fi
if run "🧬  Mutation (seams)" pm_run test:mutation; then
  OK=$((OK + 1))
fi

# Step 2b — Release readiness (read-only). auto-release.yaml tags the version
# committed in package.json and never writes it, so a push only needs the
# manifest and SBOM to agree. It is NOT required to be releasable on every push
# (a pending bump, or a manifest version already tagged, is a valid state); the
# derive step belongs to the explicit release path (`git push --release`).
if run "🔖  Release readiness" pm_run version:verify; then
  OK=$((OK + 1))
fi

# Step 3 — CVE audit (info only — cookie low vuln blocked on SvelteKit upstream)
# bun audit --severity=high exits 1 even for low severity (bun bug), so we show output but don't block.
"$PM_BIN" audit --severity=high 2>&1 || true
OK=$((OK + 1))

# Step 4 — Secret misuse scan (mirrors CI whitebox 01-policy)
if run "🔑  Secret Misuse Scan" pm_run scripts/security/scan-secret-misuse.ts --strict --full; then
  OK=$((OK + 1))
fi

# Step 4b — Hardware tiers probe (mirrors CI whitebox 01-policy)
if run "🖥️  Hardware Tiers Probe" pm_run scripts/probe/probe-hardware-tiers.ts; then
  OK=$((OK + 1))
fi

# Step 5 — Tenant isolation gate (mirrors CI whitebox 01-policy; --full scans the
# entire repo even when the local working tree has unstaged edits)
if run "🛡️  Tenant Isolation Gate" sh -c '"$1" run lint:tenant -- --full && "$1" run test:tenant' _ "$PM_BIN"; then
  OK=$((OK + 1))
fi

# Step 6 — Deploy Backdoor Probe (A01) (mirrors CI whitebox 07-deploy-backdoor)
if run "🚪  Deploy Backdoor Probe (A01)" pm_run scripts/probe/probe-deploy-testing-api.ts; then
  OK=$((OK + 1))
fi

# Step 7 — SQLite integration tests (diff-scoped; `--diff` runs only suites mapped
# from changed files and falls back to the full suite when none are affected)
if run "🗄️  Integration tests (SQLite, diff)" pm_run scripts/runs/run-integration.ts --no-build --diff; then
  OK=$((OK + 1))
fi

# Step 7b — Local DB parity. Pre-push only proves SQLite, so an adapter-specific
# regression could otherwise reach the CI matrix. Runs the cross-adapter
# contract suites against every reachable engine (auto-detected), and is a
# no-op when no adapter/database code changed. `bun run test:parity:docker`
# starts the missing engines through the test compose profiles.
if [ "${SKIP_DB_PARITY:-false}" = "true" ]; then
  warn "DB parity skipped via SKIP_DB_PARITY=true"
  OK=$((OK + 1))
elif ! has_push_changes '^(src/databases/|src/services/sdk/|src/hooks/|tests/integration/databases/|scripts/runs/integration-harness\.ts)'; then
  info "No adapter/database/service changes — parity matrix not required"
  OK=$((OK + 1))
elif run "🧬  DB parity (auto-detected engines)" pm_run test:parity -- --tests=tests/integration/databases/contract.test.ts,tests/integration/api/optimistic-lock.test.ts; then
  OK=$((OK + 1))
  # A timestamp contract that only holds in UTC is a latent bug: CI runners are
  # UTC, developer machines are not. Re-run the timestamp-bearing contract with
  # a deliberately maximal host offset (UTC+14) so an ETag/CAS mismatch between
  # the read and write lanes is caught here instead of in the CI matrix.
  TOTAL=$((TOTAL + 1))
  if run "🕒  DB parity (non-UTC clock)" env TZ=Pacific/Kiritimati "$PM_BIN" run test:parity -- --tests=tests/integration/api/optimistic-lock.test.ts; then
    OK=$((OK + 1))
  fi
fi

# Step 8 — E2E gate (Chromium) — browser verification before push
#
# The smoke spec is a runtime contract (auth → CRUD → persistence). It cannot
# see an Axe contrast failure, the RTL/status-shade sweep, a visual-regression
# baseline, or a theme-only route bug — those live in other CI shards. Until
# this mapping existed the hook was green while the change failed 2–4 CI shards.
# Targets are spec PATHS (not --grep): a path never combines with --shard and
# cannot silently select zero tests.
if [ "${SKIP_E2E_SMOKE:-false}" != "true" ]; then
  E2E_TARGETS="tests/e2e/smoke.spec.ts"
  # Any changed E2E spec must run locally too. A spec-only push previously
  # skipped the shard it edited (CI run 1847), and the hook had no mapping for
  # tests/e2e/** at all.
  CHANGED_SPECS="$(push_changed_files | grep -E '^tests/e2e/.*\.(spec|test)\.ts$' || true)"
  if [ -n "$CHANGED_SPECS" ]; then
    info "Changed E2E specs detected — running them in the browser gate"
    for spec in $CHANGED_SPECS; do
      [ -f "$spec" ] && E2E_TARGETS="$E2E_TARGETS $spec"
    done
  fi
  # Config-workspace changes have burned the Config & System shard repeatedly
  # with post-mutation reads (theme create, trash restore, density reload).
  if has_push_changes '^src/routes/\(app\)/config/|^src/routes/api/theme/'; then
    info "Config UI/API changes detected — adding the config goldens"
    E2E_TARGETS="$E2E_TARGETS tests/e2e/routes/config/design-system.spec.ts tests/e2e/routes/config/appearance-golden.spec.ts tests/e2e/routes/config/data-ops.spec.ts"
  fi
  if has_push_changes '^(src/widgets/|src/components/collection-display/|src/routes/\(app\)/\[language\]/\[\.\.\.collection\]/)'; then
    info "Collection or widget changes detected — expanding gate to include Kitchen Sink journey"
    E2E_TARGETS="$E2E_TARGETS tests/e2e/routes/collection-builder/kitchen-sink.spec.ts"
  fi
  # Any component or route-markup change can move a colour pair, an RTL
  # logical property, or an accessible name — exactly what the CI Axe/RTL jobs
  # assert. Run the accessibility contracts with the smoke gate.
  if has_push_changes '^(src/components/|src/app\.css|src/routes/.*\.svelte|src/routes/\(admin\)/)'; then
    info "UI changes detected — adding accessibility contracts (login, dashboard)"
    E2E_TARGETS="$E2E_TARGETS tests/e2e/routes/login/accessibility.spec.ts tests/e2e/routes/dashboard/accessibility.spec.ts"
  fi
  if has_push_changes '^(src/components/ui/|src/app\.css|src/routes/\(app\)/config/design-system/|src/routes/\(admin\)/)'; then
    info "Design-system changes detected — adding the admin theme visual regression"
    E2E_TARGETS="$E2E_TARGETS tests/e2e/routes/admin-theme/visual-regression.spec.ts"
  fi
  if has_push_changes '^(src/routes/\(app\)/mediagallery/|src/components/media/)'; then
    info "Media UI changes detected — adding the media theme visual audit"
    E2E_TARGETS="$E2E_TARGETS tests/e2e/routes/mediagallery/theme-visual.spec.ts"
  fi
  # A path can be added twice (e.g. a changed spec that also matches a UI mapping);
  # de-duplicate so Playwright does not run it twice and inflate the flake count.
  UNIQUE_TARGETS=""
  for target in $E2E_TARGETS; do
    case " $UNIQUE_TARGETS " in
      *" $target "*) ;;
      *) UNIQUE_TARGETS="$UNIQUE_TARGETS $target" ;;
    esac
  done
  E2E_TARGETS="${UNIQUE_TARGETS# }"
  if run "🌐  E2E Browser Gate (Chromium)" pm_run scripts/runs/run-e2e.ts --no-build $E2E_TARGETS; then
    OK=$((OK + 1))
    # Any retried-pass locally is a warning sign: CI scores it against a budget.
    if run "🎯  E2E Flake Budget" pm_run scripts/check/check-flake-budget.ts --json=tests/playwright-results.json --max-flaky=0 --max-flake-rate=3 --allow-missing; then
      OK=$((OK + 1))
    fi
  fi
else
  warn "E2E smoke gate skipped via SKIP_E2E_SMOKE=true"
  # Both the browser gate and its flake budget are skipped.
  TOTAL=$((TOTAL - 1))
  OK=$((OK + 1))
fi

summary "$OK" "$TOTAL"
res=$?

if [ "$res" -eq 0 ]; then
  # Clean up temporary precheck cache once push checks pass
  rm -rf .precheck-cache 2>/dev/null || true

  # ── Automatic semantic release on a push to main ───────────────────────
  # The bumped package.json must be part of the pushed commit, but git resolved
  # this push's SHAs before the hook ran — so the hook commits the bump and
  # performs the push itself, then aborts the stale original push. Only ever on
  # `main` (never `next`/feature branches) so the two branches do not diverge.
  CURRENT_BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  case " $PUSHED_BRANCHES " in *" main "*) PUSHES_MAIN=true ;; *) PUSHES_MAIN=false ;; esac

  if [ "$CURRENT_BRANCH" = "main" ] && [ "$PUSHES_MAIN" = true ]; then
    PUSH_REMOTE="$(git config "branch.main.remote" 2>/dev/null || true)"
    [ -n "$PUSH_REMOTE" ] || PUSH_REMOTE="origin"

    printf '\n%b\n' "${BOLD}${MAGENTA}🔖 Semantic release${NC}  ${DIM}main → ${PUSH_REMOTE}${NC}"

    # Next free patch above the highest reachable tag. Fallback for when
    # `version.ts auto` refuses a version that already carries a tag (the
    # manifest is behind a released tag, or that tag points at a commit main
    # cannot reach). A manual raise is allowed; a downgrade is not.
    HIGHEST="$(git tag --list 'v*' --merged HEAD 2>/dev/null | sed 's/^v//' | sort -V | tail -1)"
    [ -n "$HIGHEST" ] || HIGHEST="$(node -p "require('./package.json').version" 2>/dev/null || echo 0.0.0)"
    _maj="${HIGHEST%%.*}"; _rest="${HIGHEST#*.}"; _min="${_rest%%.*}"; _pat="${_rest#*.}"
    case "$_pat" in *[!0-9]*) _pat=0 ;; esac
    _pat=$((_pat + 1))
    while git rev-parse "v${_maj}.${_min}.${_pat}" >/dev/null 2>&1; do _pat=$((_pat + 1)); done
    CANDIDATE="${_maj}.${_min}.${_pat}"

    HEAD_BEFORE="$(git rev-parse HEAD)"
    if prepare_release auto || prepare_release "$CANDIDATE"; then
      if [ "$(git rev-parse HEAD)" != "$HEAD_BEFORE" ]; then
        if NESTED_RELEASE_PUSH=1 git push "$PUSH_REMOTE" "refs/heads/main:refs/heads/main"; then
          printf '%b\n' "  ${GREEN}✔${NC} release pushed to ${BOLD}${PUSH_REMOTE}/main${NC}."
          info "The original push is superseded — nothing further to push."
        else
          printf '%b\n' "  ${RED}✘${NC} release push failed — fix and push again."
        fi
        # Abort git's stale push (its SHAs predate the release commit).
        res=1
      else
        info "package.json already carries the release version — nothing to bump."
      fi
    else
      printf '\n%b\n' "  ${RED}${BOLD}Push blocked — the code checks passed, the release step did not.${NC}"
      res=1
    fi
  fi
fi

exit "$res"
