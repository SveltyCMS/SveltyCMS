#!/usr/bin/env sh
# =============================================================================
# SveltyCMS Pre-Push — Build → SQLite Integration (~5 min)
#
# Pre-commit already ran: format, lint, unit tests.
# This hook builds the project and runs the SQLite integration test suite.
# Multi-DB matrix, E2E, and full audits run in CI only.
#
# POLICY: --no-verify is blocked by git-safe.ts by default.
#
# Flags:
#   --only-failures      Skip build, re-run only previously failed suites via test:smart
#   --release[=kind]     After a green gate, bump package.json through scripts/version.ts
#                        (kind: auto|patch|minor|major — default auto), commit it as
#                        `chore(release): bump version to vX.Y.Z` and print the push
#                        that publishes it. Real pushes pass it to the wrapper:
#                        `bun run git push --release …` (git-safe exports SVELTY_RELEASE
#                        for this hook — git itself never forwards hook arguments).
#                        Skipped on the docs-only and --only-failures paths: a release
#                        commit is only ever prepared behind a full green gate.
# =============================================================================
set -u
[ "${CI:-false}" = "true" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib.sh"

require_bun
header "Pre-Push"

ONLY_FAILURES=false
RELEASE_KIND="${SVELTY_RELEASE:-}"
PUSH_REFS=""

# Parse optional arguments
for arg in "$@"; do
  case "$arg" in
    --only-failures)
      ONLY_FAILURES=true
      ;;
    --release)
      RELEASE_KIND=auto
      ;;
    --release=*)
      RELEASE_KIND="${arg#--release=}"
      ;;
  esac
done

case "$RELEASE_KIND" in
  ""|auto|patch|minor|major) ;;
  *)
    printf '%b\n' "  ${RED}✘${NC} --release=${RELEASE_KIND} is not a bump kind (auto|patch|minor|major)."
    exit 1
    ;;
esac

# git hands the refs it is about to push on stdin — one
# `<local ref> <local sha> <remote ref> <remote sha>` line per ref. Capture them
# while they are readable: they rebuild the exact "push again" hint after a
# release commit, and git never forwards them as arguments. `[ ! -t 0 ]` keeps
# manual runs (`bun run gate --release`) from blocking on a terminal.
if [ ! -t 0 ]; then
  while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/heads/*) PUSH_REFS="$PUSH_REFS HEAD:${remote_ref#refs/heads/}" ;;
    esac
  done
fi

# ── Smart skip: if only docs changed, skip build + integration ───────────
if ! has_push_changes '\.(md|mdx)$' || has_push_changes '\.(ts|js|svelte|css|json)$'; then
  HAS_CODE_CHANGES=true
else
  HAS_CODE_CHANGES=false
fi

if [ "$ONLY_FAILURES" = true ]; then
  info "Running only previously failed suites (--only-failures)"
  if [ -n "$RELEASE_KIND" ]; then
    warn "Release step skipped — --only-failures retries suites without a full gate."
    info "Prepare the release directly: ${BOLD}bun run version:bump ${RELEASE_KIND}${NC}"
  fi
  echo ""
  TOTAL=1; OK=0
  if run "🔁  Smart retry (failed suites)" bun run test:smart --only-failures; then
    OK=$((OK + 1))
  fi
  summary "$OK" "$TOTAL"
  exit $?
fi

if [ "$HAS_CODE_CHANGES" = false ]; then
  warn "Only docs changed — skipping build and integration tests"
  if [ -n "$RELEASE_KIND" ]; then
    warn "Release step skipped — it runs after the full gate, not on a docs-only push."
    info "Prepare the release directly: ${BOLD}bun run version:bump ${RELEASE_KIND}${NC}"
  fi
  echo ""
  summary 1 1
  exit 0
fi

info "Pre-commit already verified: format, lint, unit tests."
info "Pre-push: build + quality + security + backdoor probe + release readiness + SQLite integration"
echo ""

TOTAL=10; OK=0

# Step 1 — Production build (mirrors CI build job)
if run "🏗️  Build (4 adapters)" env COMPILE_ALL_ADAPTERS=true "$PM_BIN" run build; then
  OK=$((OK + 1))
fi

# Step 1b — Post-build verifiers (mirrors CI build job steps)
if run "🚪  Prod build backdoor (bench mode)" pm_run scripts/verify-prod-build-backdoor.ts --mode=bench; then
  OK=$((OK + 1))
fi
if run "📦  Bundle size gate" pm_run scripts/check-bundle-size.ts; then
  OK=$((OK + 1))
fi

# Step 2 — Quality gate (TypeScript + Svelte check — mirrors CI whitebox)
if run "✅  Quality Gate (check)" pm_run check; then
  OK=$((OK + 1))
fi

# Step 2b — Release readiness (mirrors auto-release.yaml's pre-flight)
# auto-release.yaml tags whatever package.json holds, so its first gate is
# `version:verify` (package.json ↔ sbom.json lockstep) and its second is the
# Conventional-Commits version derivation. Assert both locally and read-only so
# a green push cannot fail the release on drift or an un-derivable bump.
if run "🔖  Release readiness" sh -c "\"$PM_BIN\" run version:verify && \"$PM_BIN\" run version:bump auto --dry-run"; then
  OK=$((OK + 1))
fi

# Step 3 — CVE audit (info only — cookie low vuln blocked on SvelteKit upstream)
# bun audit --severity=high exits 1 even for low severity (bun bug), so we show output but don't block.
"$PM_BIN" audit --severity=high 2>&1 || true
OK=$((OK + 1))

# Step 4 — Secret misuse scan (mirrors CI whitebox 06-secret-misuse)
if run "🔑  Secret Misuse Scan" pm_run scripts/scan-secret-misuse.ts --strict; then
  OK=$((OK + 1))
fi

# Step 5 — Tenant isolation gate (mirrors CI whitebox 04b-tenant-gate)
if run "🛡️  Tenant Isolation Gate" pm_run test:tenant; then
  OK=$((OK + 1))
fi

# Step 6 — Deploy Backdoor Probe (A01) (mirrors CI whitebox 07-deploy-backdoor)
if run "🚪  Deploy Backdoor Probe (A01)" pm_run scripts/probe-deploy-testing-api.ts; then
  OK=$((OK + 1))
fi

# Step 7 — SQLite integration tests
if run "🗄️  Integration tests (SQLite)" pm_run scripts/run-integration.ts --no-build; then
  OK=$((OK + 1))
fi

summary "$OK" "$TOTAL"
res=$?

if [ "$res" -eq 0 ]; then
  # Clean up temporary precheck cache once push checks pass
  rm -rf .precheck-cache 2>/dev/null || true

  # ── Optional release preparation (--release / SVELTY_RELEASE) ────────────
  # Deliberately after the full gate: auto-release.yaml tags whatever
  # package.json holds, so a bump that ships without a green gate is the
  # "stray bump" AGENTS.md §8 warns about. The release commit lands on top of
  # the pushed refs, never inside them.
  if [ -n "$RELEASE_KIND" ]; then
    PUSH_REMOTE="$(git config "branch.$(git symbolic-ref --quiet --short HEAD 2>/dev/null).remote" 2>/dev/null || true)"
    [ -n "$PUSH_REMOTE" ] || PUSH_REMOTE="origin"
    [ -n "$PUSH_REFS" ] || PUSH_REFS=" HEAD"
    RELEASE_PUSH_HINT="bun run git push ${PUSH_REMOTE}${PUSH_REFS}"
    if ! prepare_release "$RELEASE_KIND"; then
      printf '\n%b\n' "  ${RED}${BOLD}Push blocked — the code checks passed, the release step did not.${NC}"
      res=1
    fi
  fi
fi

exit "$res"
