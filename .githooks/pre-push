#!/usr/bin/env sh
# =============================================================================
# SveltyCMS Pre-Push — Build → SQLite Integration (~5 min)
#
# Pre-commit already ran: format, lint, unit tests, component interaction tests.
# This hook builds the project and runs the SQLite integration suite plus a
# local DB-parity pass when adapter code changed. Multi-DB matrix, full E2E and
# audits run in CI only.
#
# Flags:
#   --only-failures      Skip build, re-run only previously failed suites via test:smart
#   SKIP_DB_PARITY=true  Skip the adapter parity step
#   SKIP_E2E_SMOKE=true  Skip the Chromium smoke gate
#
# Release: a push to `main` that passes the gate IS a release. The hook derives
# the next SemVer from Conventional Commits (`scripts/version.ts auto`, falling
# back to the next free patch when that version is already tagged), commits
# `chore(release): bump version to vX.Y.Z`, pushes that commit to main itself,
# then aborts the now-stale original push (git resolved this push's SHAs before
# the hook ran). CI then runs; on green, auto-release.yaml tags the version the
# manifest already carries. Nothing a human types but `git push`.
# =============================================================================
set -u
[ "${CI:-false}" = "true" ] && exit 0
# The release step below performs its own push; skip this hook for that push so
# it cannot recurse.
[ "${NESTED_RELEASE_PUSH:-}" = "1" ] && exit 0

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib.sh"

require_bun
header "Pre-Push"

ONLY_FAILURES=false
PUSH_REFS=""

# Parse optional arguments
for arg in "$@"; do
  case "$arg" in
    --only-failures)
      ONLY_FAILURES=true
      ;;
  esac
done

# git hands the refs it is about to push on stdin — one
# `<local ref> <local sha> <remote ref> <remote sha>` line per ref. Capture the
# branch refs so the release step can (a) know whether main is being pushed and
# (b) push the same ref itself. `[ ! -t 0 ]` keeps manual runs from blocking.
PUSHED_BRANCHES=""
if [ ! -t 0 ]; then
  while read -r local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
      refs/heads/*)
        PUSH_REFS="$PUSH_REFS ${local_ref}:${remote_ref}"
        PUSHED_BRANCHES="$PUSHED_BRANCHES ${remote_ref#refs/heads/}"
        ;;
    esac
  done
fi

# ── Smart skip: if only docs changed, skip build + integration ───────────
if ! has_push_changes '\.(md|mdx)$' || has_push_changes '\.(ts|js|svelte|css|json)$'; then
  HAS_CODE_CHANGES=true
else
  HAS_CODE_CHANGES=false
fi

if [ "$ONLY_FAILURES" = true ]; then
  info "Running only previously failed suites (--only-failures)"
  echo ""
  TOTAL=1; OK=0
  if run "🔁  Smart retry (failed suites)" bun run test:smart --only-failures; then
    OK=$((OK + 1))
  fi
  summary "$OK" "$TOTAL"
  exit $?
fi

# ── Smart skip: CI/workflow-only changes are validated by GitHub Actions ──
# A workflow/action edit cannot be exercised by the local build, integration,
# or browser smoke gate; running them only burns ~4 minutes. `main` releases
# keep the full gate, and any change outside `.github/` keeps it too.
if has_push_changes '^\.github/' \
  && ! has_push_changes '^(src/|tests/|scripts/|package\.json|bun\.lock|vite\.config|svelte\.config|path-aliases\.ts)'; then
  case " $PUSHED_BRANCHES " in
    *" main "*)
      info "CI-only change on main — keeping the full release gate"
      ;;
    *)
      warn "Only CI/workflow files changed — GitHub Actions validates this; skipping build/integration/smoke"
      echo ""
      summary 1 1
      exit 0
      ;;
  esac
fi

if [ "$HAS_CODE_CHANGES" = false ]; then
  warn "Only docs changed — skipping build and integration tests"
  echo ""
  summary 1 1
  exit 0
fi

info "Pre-commit already verified: format, lint, unit tests, component interactions."
info "Pre-push: build + quality + security + backdoor probe + release readiness + SQLite integration + DB parity + E2E smoke"
echo ""

TOTAL=12; OK=0

# Step 1 — Production build (mirrors CI build job)
if run "🏗️  Build (4 adapters)" env COMPILE_ALL_ADAPTERS=true "$PM_BIN" run build; then
  OK=$((OK + 1))
fi

# Step 1b — Post-build verifiers (mirrors CI build job steps)
if run "🚪  Prod build backdoor (bench mode)" pm_run scripts/security/verify-prod-build-backdoor.ts --mode=bench; then
  OK=$((OK + 1))
fi
if run "📦  Bundle size gate" pm_run scripts/check/check-bundle-size.ts; then
  OK=$((OK + 1))
fi

# Step 2 — Quality gate (TypeScript + Svelte check — mirrors CI whitebox)
if run "✅  Quality Gate (check)" pm_run check; then
  OK=$((OK + 1))
fi

# Step 2b — Release readiness (read-only). auto-release.yaml tags the version
# committed in package.json and never writes it, so a push only needs the
# manifest and SBOM to agree. It is NOT required to be releasable on every push
# (a pending bump, or a manifest version already tagged, is a valid state); the
# derive step belongs to the explicit release path (`git push --release`).
if run "🔖  Release readiness" pm_run version:verify; then
  OK=$((OK + 1))
fi

# Step 3 — CVE audit (info only — cookie low vuln blocked on SvelteKit upstream)
# bun audit --severity=high exits 1 even for low severity (bun bug), so we show output but don't block.
"$PM_BIN" audit --severity=high 2>&1 || true
OK=$((OK + 1))

# Step 4 — Secret misuse scan (mirrors CI whitebox 06-secret-misuse)
if run "🔑  Secret Misuse Scan" pm_run scripts/security/scan-secret-misuse.ts --strict; then
  OK=$((OK + 1))
fi

# Step 5 — Tenant isolation gate (mirrors CI whitebox 04b-tenant-gate)
if run "🛡️  Tenant Isolation Gate" pm_run test:tenant; then
  OK=$((OK + 1))
fi

# Step 6 — Deploy Backdoor Probe (A01) (mirrors CI whitebox 07-deploy-backdoor)
if run "🚪  Deploy Backdoor Probe (A01)" pm_run scripts/probe/probe-deploy-testing-api.ts; then
  OK=$((OK + 1))
fi

# Step 7 — SQLite integration tests (diff-scoped; `--diff` runs only suites mapped
# from changed files and falls back to the full suite when none are affected)
if run "🗄️  Integration tests (SQLite, diff)" pm_run scripts/runs/run-integration.ts --no-build --diff; then
  OK=$((OK + 1))
fi

# Step 7b — Local DB parity. Pre-push only proves SQLite, so an adapter-specific
# regression could otherwise reach the CI matrix. Runs the cross-adapter
# contract suites against every reachable engine (auto-detected), and is a
# no-op when no adapter/database code changed. `bun run test:parity:docker`
# starts the missing engines through the test compose profiles.
if [ "${SKIP_DB_PARITY:-false}" = "true" ]; then
  warn "DB parity skipped via SKIP_DB_PARITY=true"
  OK=$((OK + 1))
elif ! has_push_changes '^(src/databases/|tests/integration/databases/|scripts/runs/integration-harness\.ts)'; then
  info "No adapter/database changes — parity matrix not required"
  OK=$((OK + 1))
elif run "🧬  DB parity (auto-detected engines)" pm_run test:parity -- --tests=tests/integration/databases/contract.test.ts; then
  OK=$((OK + 1))
fi

# Step 8 — E2E Smoke Gate (Chromium) — fast browser verification before push
if [ "${SKIP_E2E_SMOKE:-false}" != "true" ]; then
  if run "🌐  E2E Smoke Gate (Chromium)" pm_run scripts/runs/run-e2e.ts --no-build tests/e2e/smoke.spec.ts; then
    OK=$((OK + 1))
  fi
else
  warn "E2E smoke gate skipped via SKIP_E2E_SMOKE=true"
  OK=$((OK + 1))
fi

summary "$OK" "$TOTAL"
res=$?

if [ "$res" -eq 0 ]; then
  # Clean up temporary precheck cache once push checks pass
  rm -rf .precheck-cache 2>/dev/null || true

  # ── Automatic semantic release on a push to main ───────────────────────
  # The bumped package.json must be part of the pushed commit, but git resolved
  # this push's SHAs before the hook ran — so the hook commits the bump and
  # performs the push itself, then aborts the stale original push. Only ever on
  # `main` (never `next`/feature branches) so the two branches do not diverge.
  CURRENT_BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  case " $PUSHED_BRANCHES " in *" main "*) PUSHES_MAIN=true ;; *) PUSHES_MAIN=false ;; esac

  if [ "$CURRENT_BRANCH" = "main" ] && [ "$PUSHES_MAIN" = true ]; then
    PUSH_REMOTE="$(git config "branch.main.remote" 2>/dev/null || true)"
    [ -n "$PUSH_REMOTE" ] || PUSH_REMOTE="origin"

    printf '\n%b\n' "${BOLD}${MAGENTA}🔖 Semantic release${NC}  ${DIM}main → ${PUSH_REMOTE}${NC}"

    # Next free patch above the highest reachable tag. Fallback for when
    # `version.ts auto` refuses a version that already carries a tag (the
    # manifest is behind a released tag, or that tag points at a commit main
    # cannot reach). A manual raise is allowed; a downgrade is not.
    HIGHEST="$(git tag --list 'v*' --merged HEAD 2>/dev/null | sed 's/^v//' | sort -V | tail -1)"
    [ -n "$HIGHEST" ] || HIGHEST="$(node -p "require('./package.json').version" 2>/dev/null || echo 0.0.0)"
    _maj="${HIGHEST%%.*}"; _rest="${HIGHEST#*.}"; _min="${_rest%%.*}"; _pat="${_rest#*.}"
    case "$_pat" in *[!0-9]*) _pat=0 ;; esac
    _pat=$((_pat + 1))
    while git rev-parse "v${_maj}.${_min}.${_pat}" >/dev/null 2>&1; do _pat=$((_pat + 1)); done
    CANDIDATE="${_maj}.${_min}.${_pat}"

    HEAD_BEFORE="$(git rev-parse HEAD)"
    if prepare_release auto || prepare_release "$CANDIDATE"; then
      if [ "$(git rev-parse HEAD)" != "$HEAD_BEFORE" ]; then
        if NESTED_RELEASE_PUSH=1 git push "$PUSH_REMOTE" "refs/heads/main:refs/heads/main"; then
          printf '%b\n' "  ${GREEN}✔${NC} release pushed to ${BOLD}${PUSH_REMOTE}/main${NC}."
          info "The original push is superseded — nothing further to push."
        else
          printf '%b\n' "  ${RED}✘${NC} release push failed — fix and push again."
        fi
        # Abort git's stale push (its SHAs predate the release commit).
        res=1
      else
        info "package.json already carries the release version — nothing to bump."
      fi
    else
      printf '\n%b\n' "  ${RED}${BOLD}Push blocked — the code checks passed, the release step did not.${NC}"
      res=1
    fi
  fi
fi

exit "$res"
