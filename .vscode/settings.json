{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "workbench.editor.enablePreview": true,
  "[svelte]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // Tailwind v4 at-rules (@source, @theme, @utility, @apply, @custom-variant)
  // are registered as valid via Custom Data (./css-custom-data.json), so the
  // CSS language server validates everything else instead of flagging Tailwind
  // syntax as unknown.
  "css.customData": ["./css-custom-data.json"],
  "scss.customData": ["./css-custom-data.json"],
  "less.customData": ["./css-custom-data.json"],
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.validate.enable": true,
  "javascript.validate.enable": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.codeActions.triggerOnFocusChange": true,
  "editor.linkedEditing": true,
  "svelte.enable-ts-plugin": true,
  "tailwindCSS.includeLanguages": {
    "svelte": "html"
  }
}
